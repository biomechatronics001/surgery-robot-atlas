    <limit lower="-6.2832" upper="6.2832" effort="1.0" velocity="3.1416" />
  </joint>
  <joint name="middle_ins" type="prismatic">
    <parent link="middle_rotor" />
    <child link="middle_tube" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-0.1" upper="0.1" effort="10.0" velocity="0.05" />
  </joint>
  <link name="lower_rotor">
    <visual>
      <geometry>
        <mesh filename="meshes/lower_rotor.glb" />
